# Copy these values into your server environment or a local .env file.
# Do not commit the populated .env file.
DB_HOST=localhost
DB_USER=student_portal_user
DB_PASS=replace-with-a-local-secret
DB_NAME=student_portal

API_BASE=http://localhost/student-portal/api
APP_URL=http://localhost/student-portal

PAYPAL_MODE=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=replace-with-paypal-client-id
PAYPAL_CLIENT_SECRET=replace-with-paypal-client-secret
